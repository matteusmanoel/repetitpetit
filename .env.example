# ─── Supabase ────────────────────────────────────────────────────────────────
# Project URL from Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public anon key (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Service role key — NEVER expose client-side; used only in server actions / webhooks
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ─── Mercado Pago ─────────────────────────────────────────────────────────────
# Access token from ML Developers → Credentials (Produção or Teste)
MERCADOPAGO_ACCESS_TOKEN=your_mp_access_token_here

# Public key — used client-side for the MP SDK (Brick/Checkout)
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=your_mp_public_key_here

# Webhook secret used to validate signed MP notifications
# Production webhook URL must be: {NEXT_PUBLIC_SITE_URL}/api/webhooks/mercadopago
MERCADOPAGO_WEBHOOK_SECRET=your_mp_webhook_secret_here

# Optional — force sandbox_init_point even when the Access Token is APP_USR-…
# (test credentials often use APP_USR, not TEST-). Also auto-detected via
# /users/me tag test_user when creating preferences. Values: 1 | true | yes
# MERCADOPAGO_SANDBOX=1

# ─── Site / Store ─────────────────────────────────────────────────────────────
# Full URL including https:// — used in MP preference back_urls, OG tags, tracking links
# Soft launch: must match the live Vercel production alias (not a stale/missing deploy).
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Store display name — exact brand spelling (no extra t in Repeti)
NEXT_PUBLIC_STORE_NAME=Repeti Petit

# WhatsApp number with country code, no formatting — e.g. 554599999999
NEXT_PUBLIC_STORE_WHATSAPP=554599999999
